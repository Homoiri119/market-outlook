# --- Morning outlook (core feature) uses yfinance only; the keys below are OPTIONAL ---
# and only power the supplementary per-stock signals.

# J-Quants authentication (optional; only for per-stock / sector-level features)
# Either mail/password (auto-fetches refresh token) or a pre-issued refresh token.
JQUANTS_MAIL=
JQUANTS_PASSWORD=
JQUANTS_REFRESH_TOKEN=
# Paid J-Quants API key (used by the upcoming sector/stock-level backtest)
JQUANTS_API_KEY=

# EDINET API key (optional; free registration at https://disclosure2dl.edinet-fsa.go.jp/)
EDINET_API_KEY=

# Discord Incoming Webhook URL for the 08:00 morning brief.
# ANALYZE_DISCORD_WEBHOOK_URL is preferred; DISCORD_WEBHOOK_URL is kept for compatibility.
ANALYZE_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Analysis tuning (optional)
HISTORY_DAYS=365
MACRO_SIGNAL_THRESHOLD=0.001
STOCK_SIGNAL_THRESHOLD=0.001

# Morning outlook tuning (optional)
# expected open move thresholds (fractions) and how much to weight the futures gap
OUTLOOK_STRONG_THRESHOLD=0.008
OUTLOOK_FLAT_THRESHOLD=0.002
FUTURES_GAP_WEIGHT=0.7

# Scheduler (JST, weekdays) — pre-open, before Tokyo opens at 09:00
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0
